# Phase 1 — copy this file to infra/.env before running docker compose.
# docker-compose.yml reads these to configure the Postgres container.

POSTGRES_USER=travel_admin
POSTGRES_PASSWORD=travel_pass
POSTGRES_DB=travel_planner

# Redis and Qdrant run without auth for local dev (fine on localhost-only;
# production would add a password / API key + TLS).

# These are what services/api/app/core/config.py reads once the API
# connects to the containers above.
DATABASE_URL=postgresql+asyncpg://travel_admin:travel_pass@localhost:5432/travel_planner
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6335
