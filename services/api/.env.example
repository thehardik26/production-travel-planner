# Copy this file to services/api/.env and fill in real values.
# app/core/config.py reads these; anything left out falls back to the
# default already coded in Settings (safe for local dev only).

APP_NAME=Production Travel Planner
ENV=development

# Phase 1/2 - must match infra/docker-compose.yml (see infra/.env.example
# for the actual Postgres/Redis/Qdrant container credentials and ports)
DATABASE_URL=postgresql+asyncpg://travel_admin:travel_pass@localhost:5432/travel_planner
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6335

# Phase 3 - auth. Generate a real random secret for anything beyond
# local dev, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Phase 4 - MCP tool servers (each is its own process, see
# services/mcp-*-server/). Defaults assume all five running locally on
# these ports - change only if you remapped a port.
MCP_WEATHER_SERVER_URL=http://localhost:8001/mcp
MCP_FLIGHTS_SERVER_URL=http://localhost:8002/mcp
MCP_HOTELS_SERVER_URL=http://localhost:8003/mcp
MCP_ATTRACTIONS_SERVER_URL=http://localhost:8004/mcp
MCP_TRANSPORT_SERVER_URL=http://localhost:8005/mcp

# Phase 4 - multi-user concurrency knobs
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
RATE_LIMIT_PER_MINUTE=30

# Phase 5 - Groq LLM (free tier). Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional - LangSmith tracing. See LANGSMITH_SETUP.md for the full guide.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=wanderplan-dev
