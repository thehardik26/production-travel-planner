# Copy this file to services/mcp-hotels-server/.env
MCP_HOTELS_HOST=0.0.0.0
MCP_HOTELS_PORT=8003
# Google Cloud Console -> enable "Places API (New)" on a project with
# billing enabled (a card is required, but usage stays inside the free
# monthly credit for dev/demo volume): https://console.cloud.google.com
GOOGLE_PLACES_API_KEY=
# Nominatim (OpenStreetMap) usage policy requires a descriptive User-Agent
OSM_USER_AGENT=production-travel-planner/1.0 (your-email@example.com)
